   }
 }
 
+void RimeWithWeaselHandler::RefreshBilingual() {
+  if (m_disabled || !m_active_session)
+    return;
+
+  auto it = m_session_status_map.find(m_active_session);
+  if (it == m_session_status_map.end())
+    return;
+  RimeSessionId session_id = it->second.session_id;
+  if (!session_id || !rime_api->find_session(session_id))
+    return;
+
+  RIME_STRUCT(RimeStatus, status);
+  if (!rime_api->get_status(session_id, &status))
+    return;
+  const bool composing = !!status.is_composing;
+  rime_api->free_status(&status);
+  if (!composing)
+    return;
+
+  // set_option is a public librime API. While composing, option updates call
+  // RefreshNonConfirmedComposition() on this same Weasel/Rime main thread.
+  // The option is schema-local and exists only to trigger one safe rebuild.
+  constexpr char kRefreshOption[] = "_rime_bilingual_refresh";
+  Bool next = !rime_api->get_option(session_id, kRefreshOption);
+  rime_api->set_option(session_id, kRefreshOption, next);
+  _UpdateUI(m_active_session);
+}
+
 void RimeWithWeaselHandler::OnUpdateUI(std::function<void()> const& cb) {
   _UpdateUICallback = cb;
 }
